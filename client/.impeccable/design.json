      }
    },
    "shadows": [
      {
        "name": "shadow-plate",
        "value": "0 1px 2px rgb(19 32 28 / 0.08), 0 8px 24px -12px rgb(19 32 28 / 0.25)",
        "dark": "0 1px 2px rgb(0 0 0 / 0.4), 0 8px 24px -12px rgb(0 0 0 / 0.6)",
        "purpose": "Plates lifted over the hall: composer, sign-in plate, message action strip, jump-to-latest, skip link."
      },
      {
        "name": "shadow-dialog",
        "value": "0 2px 6px rgb(19 32 28 / 0.12), 0 24px 48px -16px rgb(19 32 28 / 0.4)",
        "dark": "0 2px 6px rgb(0 0 0 / 0.5), 0 24px 48px -16px rgb(0 0 0 / 0.8)",
        "purpose": "Modal dialogs and the overlaid side panel below 1180px."
      },
      {
        "name": "brass-lip",
        "value": "inset 0 -2px 0 rgb(0 0 0 / 0.12)",
        "purpose": "Bottom lip on the brass primary button."
      },
      {
        "name": "lamp-halo-ring",
        "value": "0 0 0 3px var(--color-lamp-halo)",
        "purpose": "Glow ring around lit lamps (unread, active room, connecting); signal and clear halos use the same 3px ring, presence uses 2px."
      }
    ],
    "motion": [
      {
        "name": "ease-out",
        "value": "cubic-bezier(0.16, 1, 0.3, 1)",
        "purpose": "The only easing curve; all state transitions and loops."
      },
      {
        "name": "duration-fast",
        "value": "150ms",
        "purpose": "Hover fills, borders, button press, chevron rotation, action strip fade. 0ms under reduced motion."
      },
      {
        "name": "duration-med",
        "value": "220ms",
        "purpose": "Dialog entrance (6px rise, 0.99 scale). 0ms under reduced motion."
      },
      {
        "name": "carrier-travel",
        "value": "1.1s ease-out infinite, scaleX 0.15 to 1",
        "purpose": "In-tube carrier fill; frozen at half under reduced motion."
      },
      {
        "name": "lamp-blink",
        "value": "1.4s steps(2, jump-none) infinite, opacity 0.35",
        "purpose": "Reconnecting line lamp; off under reduced motion."
      },
      {
        "name": "typing-pulse",
        "value": "1.2s ease-out infinite, 0.15s stagger",
        "purpose": "Typing dots; off under reduced motion."
      }
    ],
    "breakpoints": [
      {
        "name": "panel-overlay",
        "value": "1180px",
        "purpose": "At or below: side panel overlays the room from the right."
      },
      {
        "name": "single-column",
        "value": "760px",
        "purpose": "At or below: board and room become separate full-screen views."
      }
    ],
    "layout": {
      "board-width": "18.5rem",
      "panel-width": "17rem (to 24rem for threads)",
      "measure": "72ch",
      "timeline-max": "56rem",
      "dialog": "30rem / 38rem wide",
      "signin-plate": "26rem"
    },
    "themes": {
      "source": "src/styles/tokens.css",
      "light": ":root",
      "dark": "@media (prefers-color-scheme: dark) :root:not([data-theme=light]), and :root[data-theme=dark]"
    }
  },
  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one brass action per surface: Send, Sign in, Accept, dialog submit.",
      "html": "<button class=\"ds-btn ds-btn-primary\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z\"/><path d=\"m21.854 2.147-10.94 10.939\"/></svg>Send</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:var(--space-2,0.5rem);min-height:2.5rem;padding:0 var(--space-4,1rem);border:1px solid transparent;border-radius:var(--radius-md,8px);font-family:var(--font-text);font-weight:600;font-size:var(--text-sm,0.875rem);cursor:pointer;transition:background-color 150ms cubic-bezier(0.16,1,0.3,1),border-color 150ms cubic-bezier(0.16,1,0.3,1),transform 150ms cubic-bezier(0.16,1,0.3,1);}.ds-btn:active{transform:translateY(1px);}.ds-btn:focus-visible{outline:2px solid var(--color-focus,#163a33);outline-offset:2px;}.ds-btn-primary{background:var(--color-brass,#c48f2c);color:var(--color-brass-ink,#1b1305);box-shadow:inset 0 -2px 0 rgb(0 0 0 / 0.12);}.ds-btn-primary:hover{background:var(--color-brass-strong,#a8761a);}"
    },
    {
      "name": "Quiet Button",
      "kind": "button",
      "refersTo": "button-quiet",
      "description": "Secondary actions on the hall: Invite, People, Leave, Cancel; toggles via aria-pressed.",
      "html": "<button class=\"ds-btn ds-btn-quiet\">Invite</button> <button class=\"ds-btn ds-btn-quiet\" aria-pressed=\"true\">People 2</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:var(--space-2,0.5rem);min-height:2.5rem;padding:0 var(--space-4,1rem);border:1px solid transparent;border-radius:var(--radius-md,8px);font-family:var(--font-text);font-weight:600;font-size:var(--text-sm,0.875rem);cursor:pointer;transition:background-color 150ms cubic-bezier(0.16,1,0.3,1),border-color 150ms cubic-bezier(0.16,1,0.3,1),transform 150ms cubic-bezier(0.16,1,0.3,1);}.ds-btn:active{transform:translateY(1px);}.ds-btn:focus-visible{outline:2px solid var(--color-focus,#163a33);outline-offset:2px;}.ds-btn-quiet{background:transparent;color:var(--color-ink,#13201c);border-color:var(--color-rule-strong,#6c7f76);}.ds-btn-quiet:hover{background:var(--color-surface-hover,#e2e9e4);}.ds-btn-quiet[aria-pressed=\"true\"]{background:var(--color-surface-sunk,#dfe6e1);border-color:var(--color-ink-muted,#48594f);}"
    },
    {
      "name": "Danger Button",
      "kind": "button",
      "refersTo": "button-danger",
      "description": "Destructive confirmations: Leave room, Delete, Deactivate.",
      "html": "<button class=\"ds-btn ds-btn-danger\">Leave room</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:var(--space-2,0.5rem);min-height:2.5rem;padding:0 var(--space-4,1rem);border:1px solid transparent;border-radius:var(--radius-md,8px);font-family:var(--font-text);font-weight:600;font-size:var(--text-sm,0.875rem);cursor:pointer;transition:background-color 150ms cubic-bezier(0.16,1,0.3,1),border-color 150ms cubic-bezier(0.16,1,0.3,1),transform 150ms cubic-bezier(0.16,1,0.3,1);}.ds-btn:active{transform:translateY(1px);}.ds-btn:focus-visible{outline:2px solid var(--color-focus,#163a33);outline-offset:2px;}.ds-btn-danger{background:var(--color-signal-surface,#f8e4e1);color:var(--color-signal-ink,#7d1a12);border-color:var(--color-signal,#b02a20);}.ds-btn-danger:hover{background:var(--color-signal,#b02a20);color:#fff;}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Labelled field with hint and error line.",
      "html": "<label class=\"ds-field\"><span class=\"ds-field-label\">Username</span><input class=\"ds-input\" placeholder=\"@you:server\"></label>",
      "css": ".ds-field{display:grid;gap:var(--space-1,0.25rem);font-family:var(--font-text);color:var(--color-ink,#13201c);}.ds-field-label{font-weight:600;font-size:var(--text-sm,0.875rem);}.ds-input{min-height:2.75rem;padding:var(--space-2,0.5rem) var(--space-3,0.75rem);background:var(--color-surface,#fbfcfa);border:1px solid var(--color-rule-strong,#6c7f76);border-radius:var(--radius-md,8px);font:inherit;color:inherit;transition:border-color 150ms cubic-bezier(0.16,1,0.3,1);}.ds-input:hover{border-color:var(--color-ink-muted,#48594f);}.ds-input:focus-visible{outline:2px solid var(--color-focus,#163a33);outline-offset:0;border-color:var(--color-focus,#163a33);}.ds-input::placeholder{color:var(--color-ink-faint,#53635b);}"
    },
    {
      "name": "Destination Board Rows",
      "kind": "nav",
      "refersTo": "room-row",
      "description": "Room rows with fixed furniture: name plate, condensed name, time, preview, and a lamp slot (unread, active, or a jammed send).",
      "html": "<nav class=\"ds-board\"><div class=\"ds-board-label\">Rooms</div><a class=\"ds-row ds-row-selected\" href=\"#\"><span class=\"ds-av ds-t0\">F</span><span class=\"ds-rb\"><span class=\"ds-rt\"><span class=\"ds-rn\">Field crew</span><span class=\"ds-time\">10:29</span></span><span class=\"ds-rt\"><span class=\"ds-pv\">You: On my way</span><span class=\"ds-active\"></span></span></span></a><a class=\"ds-row ds-unread\" href=\"#\"><span class=\"ds-av ds-t3\">E</span><span class=\"ds-rb\"><span class=\"ds-rt\"><span class=\"ds-rn\">Equipment</span><span class=\"ds-time\">10:29</span></span><span class=\"ds-rt\"><span class=\"ds-pv\">Tripods are in the van</span><span class=\"ds-lamp\">1</span></span></span></a><a class=\"ds-row\" href=\"#\"><span class=\"ds-av ds-t2\">K</span><span class=\"ds-rb\"><span class=\"ds-rt\"><span class=\"ds-rn\">Kitchen</span><span class=\"ds-time\">09:12</span></span><span class=\"ds-rt\"><span class=\"ds-pv ds-jam\">Not sent: Running late</span></span></span></a></nav>",
      "css": ".ds-board{width:18.5rem;padding:var(--space-2,0.5rem);background:var(--color-board,#163a33);color:var(--color-board-ink,#edf3ef);font-family:var(--font-text);display:grid;gap:2px;}.ds-board-label{padding:var(--space-3,0.75rem) var(--space-2,0.5rem) var(--space-1,0.25rem);font-family:var(--font-plate);font-weight:600;font-size:0.875rem;text-transform:uppercase;letter-spacing:0.12em;color:var(--color-board-ink-muted,#bfd2ca);}.ds-row{display:grid;grid-template-columns:2.25rem minmax(0,1fr);gap:var(--space-3,0.75rem);align-items:center;padding:var(--space-2,0.5rem);border-radius:var(--radius-md,8px);color:inherit;text-decoration:none;transition:background-color 150ms cubic-bezier(0.16,1,0.3,1);}.ds-row:hover{background:var(--color-board-raised,#1e4a42);}.ds-row:focus-visible{outline:2px solid var(--color-lamp,#e2ad45);outline-offset:-2px;}.ds-row-selected,.ds-row-selected:hover{background:var(--color-board-selected,#24524a);}.ds-av{display:inline-grid;place-items:center;width:2.25rem;height:2.25rem;border-radius:var(--radius-md,8px);font-family:var(--font-plate);font-weight:600;font-size:1.125rem;}.ds-t0{background:var(--color-tint-0,#f0d9a0);color:var(--color-tint-0-ink,#2b1d02);}.ds-t2{background:var(--color-tint-2,#f2c0b6);color:var(--color-tint-2-ink,#3a120b);}.ds-t3{background:var(--color-tint-3,#c3cdd8);color:var(--color-tint-3-ink,#18232e);}.ds-rb{display:grid;gap:1px;min-width:0;}.ds-rt{display:flex;align-items:baseline;gap:var(--space-2,0.5rem);min-width:0;}.ds-rn{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-family:var(--font-plate);font-weight:500;font-size:1.0625rem;line-height:1.25;}.ds-unread .ds-rn{font-weight:600;}.ds-time{font-size:0.75rem;color:var(--color-board-ink-muted,#bfd2ca);font-variant-numeric:tabular-nums;}.ds-pv{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:0.875rem;color:var(--color-board-ink-muted,#bfd2ca);}.ds-unread .ds-pv{color:var(--color-board-ink,#edf3ef);}.ds-jam{color:var(--color-board-signal,#ffb4ab);font-weight:600;}.ds-active{width:0.5rem;height:0.5rem;margin-right:0.45rem;border-radius:50%;background:var(--color-lamp,#e2ad45);box-shadow:0 0 0 3px var(--color-lamp-halo,rgb(226 173 69 / 0.28));align-self:center;}.ds-lamp{min-width:1.375rem;height:1.375rem;padding:0 0.4rem;border-radius:999px;background:var(--color-lamp,#e2ad45);color:var(--color-lamp-ink,#1b1305);font-size:0.75rem;font-weight:700;line-height:1.375rem;text-align:center;box-shadow:0 0 0 3px var(--color-lamp-halo,rgb(226 173 69 / 0.28));font-variant-numeric:tabular-nums;}"
    },
    {
      "name": "Carrier Mark",
      "kind": "custom",
      "refersTo": "carrier-mark",
      "description": "Signature per-message send state: hollow queued, filling in-tube, solid sent, solid grey delivered, notched red jammed.",
      "html": "<div class=\"ds-carriers\"><span class=\"ds-carrier ds-queued\"><svg width=\"18\" height=\"10\" viewBox=\"0 0 18 10\" aria-hidden=\"true\"><rect class=\"ds-shell\" x=\"1\" y=\"1\" width=\"16\" height=\"8\" rx=\"4\"/><rect class=\"ds-fill\" x=\"1\" y=\"1\" width=\"16\" height=\"8\" rx=\"4\"/></svg></span><span class=\"ds-carrier ds-sending\"><svg width=\"18\" height=\"10\" viewBox=\"0 0 18 10\" aria-hidden=\"true\"><rect class=\"ds-shell\" x=\"1\" y=\"1\" width=\"16\" height=\"8\" rx=\"4\"/><rect class=\"ds-fill\" x=\"1\" y=\"1\" width=\"16\" height=\"8\" rx=\"4\"/></svg></span><span class=\"ds-carrier ds-sent\"><svg width=\"18\" height=\"10\" viewBox=\"0 0 18 10\" aria-hidden=\"true\"><rect class=\"ds-shell\" x=\"1\" y=\"1\" width=\"16\" height=\"8\" rx=\"4\"/><rect class=\"ds-fill\" x=\"1\" y=\"1\" width=\"16\" height=\"8\" rx=\"4\"/></svg></span><span class=\"ds-carrier ds-delivered\"><svg width=\"18\" height=\"10\" viewBox=\"0 0 18 10\" aria-hidden=\"true\"><rect class=\"ds-shell\" x=\"1\" y=\"1\" width=\"16\" height=\"8\" rx=\"4\"/><rect class=\"ds-fill\" x=\"1\" y=\"1\" width=\"16\" height=\"8\" rx=\"4\"/></svg></span><span class=\"ds-carrier ds-failed\"><svg width=\"18\" height=\"10\" viewBox=\"0 0 18 10\" aria-hidden=\"true\"><rect class=\"ds-shell\" x=\"1\" y=\"1\" width=\"16\" height=\"8\" rx=\"4\"/><rect class=\"ds-fill\" x=\"1\" y=\"1\" width=\"16\" height=\"8\" rx=\"4\"/><path class=\"ds-notch\" d=\"M9 0v10\"/></svg></span></div>",
      "css": ".ds-carriers{display:flex;gap:1rem;align-items:center;padding:1rem;background:var(--color-ground,#e9eeea);}.ds-carrier{display:inline-flex;color:var(--color-ink-faint,#53635b);}.ds-carrier svg{overflow:visible;}.ds-shell{fill:none;stroke:currentColor;stroke-width:1.5;}.ds-fill{fill:currentColor;transform-origin:1px 5px;transform:scaleX(0);}.ds-sending,.ds-sent{color:var(--color-brass-strong,#a8761a);}.ds-sending .ds-fill{animation:ds-travel 1.1s cubic-bezier(0.16,1,0.3,1) infinite;}.ds-sent .ds-fill,.ds-delivered .ds-fill{transform:scaleX(1);}.ds-delivered{color:var(--color-rule-strong,#6c7f76);}.ds-failed{color:var(--color-signal,#b02a20);}.ds-notch{stroke:var(--color-signal-surface,#f8e4e1);stroke-width:2.5;}@keyframes ds-travel{0%{transform:scaleX(0.15);}100%{transform:scaleX(1);}}@media (prefers-reduced-motion:reduce){.ds-sending .ds-fill{animation:none;transform:scaleX(0.5);}}"
    },
    {
      "name": "Jammed Message",
      "kind": "custom",
      "refersTo": "message-failed",
      "description": "A failed send stays in place, tinted, with the reason and in-place recovery.",
      "html": "<div class=\"ds-msg ds-msg-failed\"><div class=\"ds-line\"><span class=\"ds-body\">Running five minutes late</span><span class=\"ds-carrier ds-failed\"><svg width=\"18\" height=\"10\" viewBox=\"0 0 18 10\" aria-hidden=\"true\"><rect class=\"ds-shell\" x=\"1\" y=\"1\" width=\"16\" height=\"8\" rx=\"4\"/><rect class=\"ds-fill\" x=\"1\" y=\"1\" width=\"16\" height=\"8\" rx=\"4\"/><path class=\"ds-notch\" d=\"M9 0v10\"/></svg></span></div><div class=\"ds-fail\" role=\"alert\">Not sent. Can't reach the server. <button class=\"ds-link\">Retry</button> <button class=\"ds-link\">Delete</button></div></div>",
      "css": ".ds-msg{padding:var(--space-2,0.5rem) var(--space-2,0.5rem) var(--space-2,0.5rem) 3.5rem;border-radius:var(--radius-md,8px);font-family:var(--font-text);color:var(--color-ink,#13201c);}.ds-msg-failed{background:var(--color-signal-surface,#f8e4e1);}.ds-line{display:flex;align-items:flex-end;gap:var(--space-2,0.5rem);}.ds-body{flex:1;max-width:72ch;}.ds-carrier{display:inline-flex;margin-bottom:0.4rem;color:var(--color-signal,#b02a20);}.ds-carrier svg{overflow:visible;}.ds-shell{fill:none;stroke:currentColor;stroke-width:1.5;}.ds-fill{fill:currentColor;}.ds-notch{stroke:var(--color-signal-surface,#f8e4e1);stroke-width:2.5;}.ds-fail{display:flex;flex-wrap:wrap;align-items:center;gap:var(--space-3,0.75rem);margin-top:var(--space-1,0.25rem);font-size:0.875rem;color:var(--color-signal-ink,#7d1a12);}.ds-link{padding:0;border:0;background:none;color:inherit;font:inherit;font-weight:600;text-decoration:underline;text-underline-offset:0.18em;text-decoration-thickness:1px;cursor:pointer;}.ds-link:focus-visible{outline:2px solid var(--color-focus,#163a33);outline-offset:2px;}"
    },
    {
      "name": "Composer Slot",
      "kind": "input",
      "refersTo": "composer",
      "description": "The dispatch slot anchored under the timeline, with brass Send.",
      "html": "<div class=\"ds-composer\"><textarea class=\"ds-ci\" rows=\"1\" placeholder=\"Message Field crew\"></textarea><button class=\"ds-send\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z\"/><path d=\"m21.854 2.147-10.94 10.939\"/></svg>Send</button></div>",
      "css": ".ds-composer{display:flex;align-items:flex-end;gap:var(--space-2,0.5rem);padding:var(--space-2,0.5rem);background:var(--color-surface,#fbfcfa);border:1px solid var(--color-rule-strong,#6c7f76);border-radius:var(--radius-lg,14px);box-shadow:var(--shadow-plate,0 1px 2px rgb(19 32 28 / 0.08),0 8px 24px -12px rgb(19 32 28 / 0.25));font-family:var(--font-text);}.ds-composer:focus-within{border-color:var(--color-focus,#163a33);}.ds-ci{flex:1;min-height:2.5rem;max-height:12rem;padding:var(--space-2,0.5rem) var(--space-3,0.75rem);border:0;background:transparent;resize:none;font:inherit;line-height:1.5;color:var(--color-ink,#13201c);}.ds-ci:focus{outline:none;}.ds-ci::placeholder{color:var(--color-ink-faint,#53635b);}.ds-send{display:inline-flex;align-items:center;gap:0.5rem;min-height:2.5rem;padding:0 1rem;border:0;border-radius:var(--radius-md,8px);background:var(--color-brass,#c48f2c);color:var(--color-brass-ink,#1b1305);box-shadow:inset 0 -2px 0 rgb(0 0 0 / 0.12);font:inherit;font-weight:600;font-size:0.875rem;cursor:pointer;transition:background-color 150ms cubic-bezier(0.16,1,0.3,1);}.ds-send:hover{background:var(--color-brass-strong,#a8761a);}.ds-send:focus-visible{outline:2px solid var(--color-focus,#163a33);outline-offset:2px;}"
    },
    {
      "name": "Day Plate",
      "kind": "chip",
      "refersTo": "day-plate",
      "description": "Signage pill breaking the timeline by day, hairlines to both edges.",
      "html": "<div class=\"ds-day\"><span>Today</span></div>",
      "css": ".ds-day{display:flex;align-items:center;gap:var(--space-3,0.75rem);padding:1rem;background:var(--color-ground,#e9eeea);font-family:var(--font-plate);font-weight:600;font-size:0.875rem;text-transform:uppercase;letter-spacing:0.12em;color:var(--color-ink-muted,#48594f);}.ds-day::before,.ds-day::after{content:\"\";flex:1;height:1px;background:var(--color-rule,#c3cfc8);}.ds-day span{padding:0.125rem var(--space-3,0.75rem);border:1px solid var(--color-rule,#c3cfc8);border-radius:999px;background:var(--color-surface,#fbfcfa);}"
    },
    {
      "name": "Enamel Dialog Plate",
      "kind": "card",
      "refersTo": "dialog",
      "description": "White enamel plate for dialogs: headline title, muted description, actions right with the brass primary last.",
      "html": "<div class=\"ds-dialog\"><h2 class=\"ds-dh\">Invite to Field crew</h2><p class=\"ds-dd\">They will see the invite on their board.</p><div class=\"ds-da\"><button class=\"ds-db ds-dq\">Cancel</button><button class=\"ds-db ds-dp\">Send invite</button></div></div>",
      "css": ".ds-dialog{width:min(100%,30rem);padding:var(--space-5,1.5rem);background:var(--color-surface,#fbfcfa);color:var(--color-ink,#13201c);border-radius:var(--radius-lg,14px);box-shadow:var(--shadow-dialog,0 2px 6px rgb(19 32 28 / 0.12),0 24px 48px -16px rgb(19 32 28 / 0.4));font-family:var(--font-text);}.ds-dh{margin:0 0 var(--space-4,1rem);font-family:var(--font-plate);font-weight:600;font-size:1.375rem;line-height:1.2;}.ds-dd{margin:-0.5rem 0 var(--space-4,1rem);color:var(--color-ink-muted,#48594f);}.ds-da{display:flex;justify-content:flex-end;gap:var(--space-2,0.5rem);}.ds-db{min-height:2.5rem;padding:0 1rem;border:1px solid transparent;border-radius:var(--radius-md,8px);font:inherit;font-weight:600;font-size:0.875rem;cursor:pointer;}.ds-db:focus-visible{outline:2px solid var(--color-focus,#163a33);outline-offset:2px;}.ds-dq{background:transparent;color:inherit;border-color:var(--color-rule-strong,#6c7f76);}.ds-dq:hover{background:var(--color-surface-hover,#e2e9e4);}.ds-dp{background:var(--color-brass,#c48f2c);color:var(--color-brass-ink,#1b1305);box-shadow:inset 0 -2px 0 rgb(0 0 0 / 0.12);}.ds-dp:hover{background:var(--color-brass-strong,#a8761a);}"
    }
  ],
  "narrative": {
    "northStar": "The Dispatch Hall",
    "overview": "Every message is a carrier sent down a tube. The client is a station hall in enamel: a cool pale ground where conversation is read and written, a deep tube-green destination board down the left where you choose where to send, and white enamel plates (the room header, the composer slot, dialogs, the sign-in card) that sit on top of the hall. The system's one job beyond legibility is to show where each carrier is and whether the line is clear, so state is drawn as physical furniture: lamps that glow, carrier capsules that fill, a line-status lamp at the foot of the board.\n\nDensity is that of a working tool used all day in one tab: compact rows on a 4px grid, fixed row furniture (every room row has the same plate, name, time, preview and lamp positions), and a reading measure of 72ch for message bodies. Two faces divide the work: a condensed signage face for anything you navigate by, a hyperlegible grotesk for anything you read or type, with tabular numerals throughout. Brass is scarce and therefore meaningful; signal red appears only where something needs a hand.\n\nThe night shift is the same hall in green-black enamel, where the brass lamps glow brighter. Light and dark are both first-class, swapped entirely through tokens (system preference by default, with an explicit light or dark override on the root). The world refuses the default bubble chat: no coloured speech bubbles, no grey ticks, no failures that vanish into a toast.",
    "keyCharacteristics": [
      "Tube-green destination board for navigation, pale enamel hall for reading, white enamel plates on top.",
      "Brass marks the primary action, lamps and links; red marks jams, errors, mentions and destruction.",
      "Condensed signage face (Barlow Condensed) for names, headings and plate labels; Atkinson Hyperlegible Next for messages and controls.",
      "Per-message carrier mark with four visible states; failures stay in place with their recovery actions.",
      "Round lamps with a 3px halo ring for every live state: unread, active room, line status, presence.",
      "Short ease-out motion (150 to 220ms), all of it zeroed under reduced motion."
    ],
    "rules": [
      {
        "name": "The Brass Is Earned Rule",
        "body": "Brass appears only where there is an action or a live state: the single primary button, lamps, links, carrier progress, your own marks. It is never a background area larger than a button and never decoration.",
        "section": "colors"
      },
      {
        "name": "The Red Means Hands Rule",
        "body": "Signal red marks only what needs the person now: a jammed send, an error, a mention, a destructive action. A state that is merely inactive or offline is grey, not red.",
        "section": "colors"
      },
      {
        "name": "The Night Shift Rule",
        "body": "Every colour token has a dark value in `tokens.css` (only `lamp-ink` stays dark in both shifts, because lamps stay bright), applied under `prefers-color-scheme: dark` unless the root says `data-theme=\"light\"`, or forced by `data-theme=\"dark\"`. Components never branch on theme and never carry a literal colour.",
        "section": "colors"
      },
      {
        "name": "The Two Faces Rule",
        "body": "Things you navigate by (room names, headings, section and day plates, the wordmark) are set in Barlow Condensed; things you read or type (messages, previews, controls, fields) are set in Atkinson Hyperlegible Next. Never set message text in the condensed face.",
        "section": "typography"
      },
      {
        "name": "The Rank By Weight Rule",
        "body": "Within a list, importance is shown by weight and case, not size: unread rooms go from 500 to 600 and their preview from chalk to full board ink.",
        "section": "typography"
      },
      {
        "name": "The Tabular Rule",
        "body": "Tabular numerals are on for the whole document; times, counts and lamps never jitter.",
        "section": "typography"
      },
      {
        "name": "The Signage Label Rule",
        "body": "Uppercase tracked plate labels name a section, a list, a day or the line's state, and sit at the head of that thing. They are never placed above a heading as a kicker.",
        "section": "typography"
      },
      {
        "name": "The Anchored Timeline Rule",
        "body": "The newest message always sits directly above the composer; empty space collects above the history, never between the last message and the slot.",
        "section": "layout"
      },
      {
        "name": "The Fixed Furniture Rule",
        "body": "Every room row has the same slots in the same places: name plate, room name, time, preview, and a right-hand lamp position for unread, active or carrier state. Content changes; furniture does not move.",
        "section": "layout"
      },
      {
        "name": "The Lifted Plates Rule",
        "body": "Shadows belong only to things that sit over the hall (composer, dialogs, overlays, the floating action strip). Rows, cards on the board, settings sections and the timeline stay flat and use tone or a hairline.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** take every colour, size, space, radius, shadow and duration from `tokens.css`; add a token (with a dark value) before using a new one.",
      "**Do** keep exactly one brass primary action per surface, and show every send's carrier state beside the message.",
      "**Do** keep a failed send in place in the timeline and on its board row, with Retry and Delete beside it.",
      "**Do** mark live state with a round lamp and its halo ring, including the open room.",
      "**Do** use the global 2px focus outline (tube green by day, pale tube green by night, lamp brass on the board) and keep every text pair at WCAG AA in both themes.",
      "**Do** keep motion between 150 and 220ms with the ease-out curve, and let it fall to zero under `prefers-reduced-motion`.",
      "**Do** announce new messages, send failures and line changes through live regions, since the visual state is not enough on its own."
    ],
    "donts": [
      "**Don't** render messages as coloured speech bubbles or report send state with grey ticks.",
      "**Don't** mark the selected room with a coloured side stripe; the active room gets a lamp.",
      "**Don't** report a failed send only in a toast or banner that can disappear.",
      "**Don't** use brass or signal red as decoration, large fills or emphasis for ordinary text.",
      "**Don't** set message or input text in the condensed signage face.",
      "**Don't** place an uppercase tracked label above a heading as a kicker.",
      "**Don't** give flat hall furniture (rows, board cards, settings sections) a drop shadow."
    ]
  }
}
