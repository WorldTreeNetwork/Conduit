{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT user_id, room_id, event_id, stream_pos, thread_id, actions, highlight, ts\n            FROM push_notifications\n            WHERE user_id = $1\n              AND ($2::BIGINT IS NULL OR stream_pos < $2)\n              AND (NOT $3 OR highlight)\n            ORDER BY stream_pos DESC\n            LIMIT $4\n            ",
